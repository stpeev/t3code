{
  // Source: config/pipelines.jsonc in the t3code fork. Edit it there, then `vp run pipelines:install`.
  // "hub-ticket" copied from claude-hub apps/web/src/pipeline/template.ts (TICKET_STAGES).
  "pipelines": [
    {
      "id": "standard",
      "name": "Standard",
      "automation": "manual",
      "maxContinuations": 1,
      "stages": [
        {
          "id": "plan",
          "name": "Plan",
          "prompt": "/analyze-ask {input}",
          "approval": false,
        },
        {
          "id": "challenge-design",
          "name": "Challenge design",
          "prompt": "/challenge-design on the spec written by the previous stage",
          "approval": true,
        },
        {
          "id": "design-review",
          "name": "Design review",
          "prompt": "/review-spec of the same spec",
          "approval": false,
        },
        {
          "id": "in-progress",
          "name": "In progress",
          "prompt": "The plan is approved now. Implement it in a worktree following the /create-branch instructions. Commit locally; don't push or open a PR yet.",
          "approval": false,
        },
        {
          "id": "code-review",
          "name": "Code review",
          "prompt": "Review this change using independent reviewer",
          "approval": false,
        },
        {
          "id": "test",
          "name": "Test",
          "prompt": "Propose conducting local experiments in attempt to replicate the conditions being address with the change and then verify the change itself using the same experimental setup. Also evaluate whether new tests (e2e, integration, unit) are needed. If so, propose to write some. Run all `affected tests` (including e2e) of every module this change touches, and wait for each to finish. Fix what fails and run them again until all pass, then give me the passed, failed and skipped counts per suite.",
          "approval": false,
        },
        {
          "id": "pr",
          "name": "PR",
          "prompt": "/pr-push",
          "approval": false,
        },
        {
          "id": "testing-done",
          "name": "Testing done",
          "prompt": "/pr-testing-done",
          "approval": false,
        },
        {
          "id": "screenshots",
          "name": "Screenshots",
          "prompt": "/annotated-screenshots, then upload the PNGs and add them to this PR's description (the command itself only writes files; update the PR body here)",
          "approval": false,
        },
        {
          "id": "babysit-pr",
          "name": "Babysit PR",
          "prompt": "/babysit-pr",
          "approval": false,
        },
        {
          "id": "ready-to-merge",
          "name": "Merge",
          "prompt": "Watch this thread's PR with watch_pull_request; on each wake-up check `gh pr view --json state` for MERGED.",
          "approval": false,
        },
        {
          "id": "followups",
          "name": "Follow-ups",
          "prompt": "Inspect the spec once more for leftovers or follow-up records and take a decisions on those",
          "approval": false,
        },
        {
          "id": "done",
          "name": "Done",
          "prompt": "Nothing to do here — every stage before this one is finished. Just end your reply with `PIPELINE: DONE` and stop.",
          "approval": false,
        },
      ],
    },
    {
      "id": "goal",
      "name": "Goal",
      "automation": "auto",
      "maxContinuations": 5,
      "stages": [
        {
          "id": "work",
          "name": "Work",
          "prompt": "Goal: {input}\n\nWork on this goal until it is fully achieved and verified. Run tests, builds and checks in the foreground and wait for their result; don't stop early.",
          "verifyPrompt": "Is the goal fully achieved: {input}? Check the actual outcome (code, tests, PR state), not just the plan. If anything is missing, REJECT with what is left.",
          "approval": true,
        },
        {
          "id": "done",
          "name": "Done",
          "prompt": "Nothing to do here — every stage before this one is finished. Just end your reply with `PIPELINE: DONE` and stop.",
          "approval": false,
        },
      ],
    },
    {
      // Coordinator: run in one thread with the epic key as input. Each story runs "epic-story"
      // in its own worktree thread, started over MCP (pipeline_start).
      "id": "epic",
      "name": "Epic",
      "automation": "auto",
      "maxContinuations": 2,
      "stages": [
        {
          "id": "breakdown",
          "name": "Breakdown",
          "approval": true,
          "prompt": "Epic: {input}. Read the epic and its stories in Jira, explore the code, and split the epic into stories that each ship as one reviewable PR. Write .pipeline-reports/epic.json: [{ \"key\", \"title\", \"acceptance\", \"dependsOn\": [keys], \"base\": \"main\" or the key of the story it stacks on }]. Prefer independent stories; stack only when a story can't build without another. Change no code.",
          "verifyPrompt": "Each story in .pipeline-reports/epic.json is one PR in size with testable acceptance criteria, dependsOn has no cycles, and together the stories cover all of {input}.",
        },
        {
          "id": "dispatch",
          "name": "Dispatch",
          "prompt": "Read .pipeline-reports/epic.json; get this thread's id and projectId from t3_thread_list (it marks your own thread). A story is local-done when its thread reported local-done, finished when it reported DONE — record both in epic-state.json; no PR approval/merge needed, and a local-done story frees its maxConcurrent slot. A story can start when its base (if any) and all other dependsOn are local-done — stack on the base story's local branch. For each startable story (while the count of started-but-not-local-done stories is below maxConcurrent, no limit if unset): name a branch as /create-branch would; t3_thread_launch in this project a worktree thread (type \"worktree\", baseRef \"origin/main\" or the base story's branch, branch <name>, title \"<key> <title>\", no message); pipeline_start it as pipelineId \"epic-story\" with input \"<key>: <title> (epic thread: <this thread's id>; base branch: <main or base story's branch>)\"; set `git config branch.<branch>.gh-merge-base <baseRef>`; record maxConcurrent and key -> threadId, worktree, branch, base in epic-state.json (the worktree auto-lands repo-locally at .claude/worktrees/<branch> when the worktree location setting is relative). Call pipeline_status for all story threads; reply with a table (key, stage, status, branch, base, PR). End DONE only when every story's thread is DONE, FAILED if one failed unrecoverably, else WAITING; on each story message, record it, start newly startable ones, re-check, end with a verdict line.",
        },
        {
          "id": "integrate",
          "name": "Integrate",
          "prompt": "Every story of {input} is ready or merged. In a fresh worktree from origin/main, merge each unmerged story branch locally in dependency order (don't push), then build, run the test suites of every module the epic touched in the foreground, and check the epic's acceptance criteria end to end. Remove the worktree when done.",
          "verifyPrompt": "Every acceptance criterion of {input} is shown to hold on main with every story branch merged in.",
        },
        {
          "id": "close",
          "name": "Close",
          "prompt": "Gather follow-ups from every story's .pipeline-reports and PR threads; file each as a Jira ticket or drop it with a reason. Post a summary of {input} on the epic in Jira: each story with its PR, state and base branch, and the order to merge the stacked PRs (a PR's base must merge first, then rebase the PRs on top of it). Transition the epic only if every story PR is merged.",
        },
      ],
    },
    {
      // One story of an epic; the epic's Dispatch stage starts it. {input} names the epic thread.
      "id": "epic-story",
      "name": "Epic story",
      "automation": "auto",
      "maxContinuations": 2,
      "stages": [
        {
          "id": "plan",
          "name": "Plan",
          "prompt": "/analyze-ask {input}",
        },
        {
          "id": "develop",
          "name": "Develop",
          "prompt": "The plan is approved now. Dispatch normally launches this thread in its own worktree already on the story's branch — implement there; only if this thread is still at the project root, run /create-branch with 'Worktree + enter' first (create the branch from the base branch named in \"{input}\", not from HEAD) and continue in that worktree. Commit locally; don't push or open a PR yet. Tests first, then the change, then run the tests you added.",
        },
        {
          "id": "code-review",
          "name": "Code review",
          "prompt": "Review this change using an independent reviewer and fix what it finds. Commit locally.",
        },
        {
          "id": "test",
          "name": "Test",
          "prompt": "Run all affected tests of every module this change touches in the foreground and wait for each to finish. Fix what fails and run them again until all pass, then give the passed, failed and skipped counts per suite.",
        },
        {
          "id": "local-done",
          "name": "Local done",
          "prompt": "All local deliverables are done (code reviewed, tests green). t3_thread_send the epic thread named in \"{input}\": \"Story <key> local-done. Branch: <branch>. Worktree: <absolute path>. Thread: <this thread's id>. Stories depending on or stacked on it can start on this branch now. Run the Dispatch check again.\" Then end your reply with `PIPELINE: DONE`.",
        },
        {
          "id": "pr",
          "name": "PR",
          "prompt": "/pr-push with the PR's base set to the base branch named in \"{input}\", so a stacked story's PR shows only its own changes.",
        },
        {
          "id": "testing-done",
          "name": "Testing done",
          "prompt": "/pr-testing-done",
        },
        {
          "id": "ready",
          "name": "Ready",
          "prompt": "Call watch_pull_request on this story's PR. The story is ready as soon as the PR is open — end with DONE then; checks don't need to be green, approved, or merged first. Keep watching afterwards: on each wake-up handle failed checks and review comments, pushing fixes. Until the PR is open, end with WAITING.",
        },
        {
          "id": "report",
          "name": "Report",
          "prompt": "t3_thread_send the epic thread named in \"{input}\" this message, filled in: \"Story <key> is ready. PR: <url> (<state>). Branch: <branch>, base: <base branch>. Worktree: <absolute path>. Thread: <this thread's id>. Stories that depend on it can stack on this branch. Run the Dispatch check again and end with a PIPELINE verdict line.\" Keep watching the PR: if it gets new comments or checks fail later, fix them and push.",
        },
        {
          "id": "done",
          "name": "Done",
          "prompt": "Nothing to do here — every stage before this one is finished. Just end your reply with `PIPELINE: DONE` and stop.",
        },
      ],
    },
  ],
}
